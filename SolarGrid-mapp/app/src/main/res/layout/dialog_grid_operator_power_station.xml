<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@drawable/modal_bg">

    <!-- Station Name -->
    <TextView
        android:id="@+id/stationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Mahavali Substation"
        android:textColor="#FFD21C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans" />

    <!-- Station Image -->
    <FrameLayout
        android:layout_width="268dp"
        android:layout_height="125dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/station_image_bg"
        android:clipChildren="true"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/stationImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/station"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Power station image" />

    </FrameLayout>

    <!-- Distance & Status Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Location Icon -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#FFD21C"
            android:textSize="28sp" />

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance"
                android:textColor="#AAB5AE"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/stationDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 km"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/stationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Operational"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/today_badge" />

    </LinearLayout>

    <!-- Close Button -->
    <FrameLayout
        android:id="@+id/closeButton"
        android:layout_width="140dp"
        android:layout_height="38dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_energy_button">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

</LinearLayout>
