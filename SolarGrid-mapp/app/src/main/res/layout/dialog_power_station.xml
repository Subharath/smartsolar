<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:background="@drawable/modal_bg">

    <!-- Station Name -->
    <TextView
        android:id="@+id/stationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Mahavali Sub"
        android:textColor="#FFD21C"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans" />

    <!-- Station Image -->
    <FrameLayout
        android:layout_width="276dp"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/station_image_bg"
        android:clipChildren="true"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/stationImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/station"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Power station image" />

    </FrameLayout>
    <!-- Distance Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Location Icon -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#FFD21C"
            android:textSize="30sp" />

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance"
                android:textColor="#AAB5AE"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/stationDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 km"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Continue Button -->
    <FrameLayout
        android:id="@+id/continueButton"
        android:layout_width="145dp"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_energy_button">

        <!-- Continue text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

</LinearLayout>