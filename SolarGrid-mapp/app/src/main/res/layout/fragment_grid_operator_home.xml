<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full screen background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/dashboardbg"
        android:contentDescription="@null" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <FrameLayout
                android:id="@+id/dashboardHeader"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_header"
                android:clipToOutline="true">

                <!-- Profile Avatar -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="30dp"
                    android:padding="7dp"
                    android:src="@drawable/user"
                    android:contentDescription="Profile" />

                <!-- Greeting text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="38dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Hi"
                            android:textColor="@android:color/white"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/operatorNameGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Operator,"
                            android:textColor="#00B565"
                            android:textSize="25sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome!"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Notification Button -->
                <ImageView
                    android:id="@+id/notificationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="14dp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:src="@drawable/notification"
                    android:contentDescription="Notifications" />

            </FrameLayout>


            <!-- ========================= -->
            <!-- CARD 1: SCAN QR CODE -->
            <!-- ========================= -->

            <FrameLayout
                android:id="@+id/scanQrCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="175dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_energy_card">

                <!-- Decorative leaves -->
                <ImageView
                    android:id="@+id/energyLeaves"
                    android:layout_width="145dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginBottom="-10dp"
                    android:layout_marginEnd="-12dp"
                    android:scaleType="fitCenter"
                    android:alpha="0.40"
                    android:src="@drawable/energy_leaves"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Headline -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="110dp"
                        android:text="Verify a prosumer's energy transfer by scanning their transaction QR code"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <!-- Yellow divider -->
                    <View
                        android:layout_width="50dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:background="#F6D400" />

                    <!-- Scan QR Code button -->
                    <LinearLayout
                        android:id="@+id/scanQrButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_energy_button"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Yellow Camera Circle -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_lightning_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:contentDescription="@null" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Scan QR Code"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>


            <!-- ========================= -->
            <!-- CARD 2: NEARBY STATIONS -->
            <!-- ========================= -->

            <FrameLayout
                android:id="@+id/nearbyStationsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="175dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_login_card">

                <!-- Map Graphic Image -->
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="130dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mapbg"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Headline -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="110dp"
                        android:text="View nearby stations on map and check operational details"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <!-- Yellow divider -->
                    <View
                        android:layout_width="50dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:background="#F6D400" />

                    <!-- Nearby Stations button -->
                    <LinearLayout
                        android:id="@+id/nearbyStationsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_outline_button"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Yellow Location Pin Circle -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_lightning_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_location_pin"
                                android:contentDescription="@null" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Nearby Stations"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
