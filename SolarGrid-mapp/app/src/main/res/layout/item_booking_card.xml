<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/reservation_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/station"
            android:background="@drawable/station_image_bg"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Station" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardStationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo Central Microgrid"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardScheduledDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2026-10-15"
                android:textColor="#AFC7BC"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/cardStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/today_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Approved"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardTimeSlot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Time: 10:00 AM"
            android:textColor="#D0D0D0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cardEnergy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25.0 kWh"
            android:textColor="#00D084"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/cardQrToken"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Token: SOLAR-TX-DEMO"
        android:textColor="#F2C300"
        android:textSize="11sp" />

    <!-- Action Buttons for Pending / Active Reservations -->
    <LinearLayout
        android:id="@+id/cardActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cardViewQrBtn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="View QR"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_energy_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/cardModifyBtn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="Modify Slot"
            android:textColor="#E0F2E9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/history_tab_unselected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/cardCancelBtn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Cancel Slot"
            android:textColor="#FF8A80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_button"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
